# Ollama (Local LLM)
# บน Docker: ใช้ http://host.docker.internal:11434/v1
# บน PC/Local: ใช้ http://localhost:11434/v1
# บน NAS ที่ Ollama รันบน PC แยกตัว: ใช้ http://[PC-IP]:11434/v1
OLLAMA_BASE_URL=http://192.168.51.235:11434/v1   # Ollama port = 11434 (ไม่ใช่ 1234)
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120  # วินาที (timeout สำหรับ streaming)
OLLAMA_MAX_RETRIES=2  # จำนวนครั้งที่ retry เมื่อ connection fail
OLLAMA_RETRY_DELAY=2  # วินาที (initial delay ก่อน retry แรก)

# LM Studio (Local LLM ทางเลือก — OpenAI compatible) — OPT-IN
# ปล่อยว่าง = ปิด (local หลักคือ Ollama ด้านบน). ใส่ค่าเฉพาะเมื่อรัน LM Studio จริงเท่านั้น
# ถ้าใส่ → provider=ollama และ auto-route จะวิ่งไป LM Studio แทน Ollama
# LMSTUDIO_BASE_URL=http://192.168.51.235:1234/v1

# Gemini (Cloud LLM) — ขอ key ฟรีที่ https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ChromaDB (Long-term Memory)
# บน Docker: ใช้ service name "chromadb" (ถ้ามี service chromadb ใน docker-compose)
# บน NAS ที่ ChromaDB รันแยกตัว: ใช้ IP address ของ NAS
# บน Local: ใช้ "localhost" หรือ IP address
CHROMA_HOST=192.168.51.49
CHROMA_PORT=8000

# SQLite — ชี้ไปที่ NAS path (ถ้าไม่ใส่จะใช้ local ./chat_history.db)
# Mac mount:  DB_PATH=/Volumes/NAS/hybrid-ai/chat_history.db
# Synology:   DB_PATH=/volume1/docker/hybrid-ai/chat_history.db
DB_PATH=

# NAS data folder สำหรับ docker-compose volume mount (Synology path)
# ตั้งค่าเพื่อให้ข้อมูลบันทึกลง NAS ไม่หายเวลา restart container
# NAS_DATA_PATH=/volume1/docker/hybrid-ai
NAS_DATA_PATH=

# Obsidian Vault — path ของ vault บน NAS (ภายใน Docker container)
# Synology: OBSIDIAN_VAULT_PATH=/vault
OBSIDIAN_VAULT_PATH=

# RELOAD — เปิด/ปิด uvicorn reload (default: false สำหรับ production)
# RELOAD=true

# LINE Notify — แจ้งเตือนเมื่อ Dream Cycle ล้มเหลว
# ขอ token ได้ที่ https://notify-bot.line.me/my/
LINE_NOTIFY_TOKEN=

# Auth — ตั้งรหัสผ่านเพื่อป้องกัน UI (ถ้าไม่ใส่ = เปิดสาธารณะ)
UI_PASSWORD=

# CORS — origins ที่อนุญาต (คั่นด้วย comma, ถ้าไม่ใส่ใช้ค่า default)
# CORS_ORIGINS=http://192.168.51.49:8080,https://ai.pawinhome.com

# Home Network Tools — NAS Synology API + Wake-on-LAN
NAS_IP=192.168.51.49
NAS_PORT=5000
NAS_USER=pawin
NAS_PASS=your_nas_password
PC_IP=192.168.51.235
# PC_MAC — ดู MAC address ด้วย: ipconfig /all (Windows) หรือ ip link show (Linux)
PC_MAC=
