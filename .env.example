# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120  # วินาที (timeout สำหรับ streaming)
OLLAMA_MAX_RETRIES=3  # จำนวนครั้งที่ retry เมื่อ connection fail
OLLAMA_RETRY_DELAY=2  # วินาที (initial delay ก่อน retry แรก)

# Gemini (Cloud LLM) — ขอ key ฟรีที่ https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ChromaDB (Long-term Memory)
# ใน Docker: ใช้ service name "chromadb" (ไม่ใช่ localhost)
# ใน Local: ใช้ "localhost" หรือ IP address
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# SQLite — ชี้ไปที่ NAS path (ถ้าไม่ใส่จะใช้ local ./chat_history.db)
# Mac mount:  DB_PATH=/Volumes/NAS/hybrid-ai/chat_history.db
# Synology:   DB_PATH=/volume1/docker/hybrid-ai/chat_history.db
DB_PATH=

# NAS data folder สำหรับ docker-compose volume mount (Synology path)
# NAS_DATA_PATH=/volume1/docker/hybrid-ai
NAS_DATA_PATH=

# Obsidian Vault — path ของ vault บน NAS (ภายใน Docker container)
# Synology: OBSIDIAN_VAULT_PATH=/vault
OBSIDIAN_VAULT_PATH=
