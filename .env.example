# ══ ⬇️ ส่วนนี้สร้างอัตโนมัติจาก core/env_registry.py — ห้ามแก้ด้วยมือ ══
# แก้คำอธิบาย/ค่าตั้งต้นที่ `core/config.py` แล้วรัน:
#     python scripts/gen_env_example.py --write
# มีเทสเทียบไฟล์นี้กับ registry ทุกครั้ง (tests/test_env_example_generated.py)


# ── Ollama ────────────────────────────────────────────────────────────────────
# ที่อยู่ Ollama (OpenAI-compatible) — ⚠️ พอร์ต 11434 ไม่ใช่ 1234
# บน Docker: http://host.docker.internal:11434/v1
# บน NAS ที่ Ollama รันบน PC แยกตัว: http://[PC-IP]:11434/v1
# เป็นตัวหลักของ embeddings (ทิศตรงข้ามกับงานแชทที่ LM Studio เป็นหลัก)
OLLAMA_BASE_URL=http://localhost:11434/v1
# โมเดลแชทของ Ollama (บทบาท fallback ตั้งแต่ 2026-06-15)
OLLAMA_MODEL=llama3
# วินาที
OLLAMA_TIMEOUT=120
# จำนวนครั้งที่ลองซ้ำ
OLLAMA_MAX_RETRIES=2
# วินาทีระหว่างการลองซ้ำ
OLLAMA_RETRY_DELAY=2
# ความสร้างสรรค์ 0-1
OLLAMA_TEMPERATURE=0.7
# nucleus sampling
OLLAMA_TOP_P=0.85
# ขนาด context window
OLLAMA_NUM_CTX=4096
# โทษการพูดซ้ำ
OLLAMA_REPEAT_PENALTY=1.1

# ── Gemini ────────────────────────────────────────────────────────────────────
# คีย์ Gemini (ขอฟรีที่ https://aistudio.google.com/)
# ว่าง = ปิดเส้นคลาวด์ทั้งหมด
GEMINI_API_KEY=
# โมเดลสายเสียงสด — ต้องเป็นสาย *-live/native-audio เท่านั้น
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# โมเดลแชท Gemini (ค่าตั้งต้นอยู่ที่ utils/llm.py:GEMINI_MODEL_DEFAULT)
# ⚠️ ห้ามใช้รุ่นที่ Google ปิดแล้ว — ดู RETIRED_GEMINI_MODELS / GEMINI_MODEL_SUNSET
# prod ใช้ gemini-3.5-flash-lite (โควตาเป็นรายโมเดล ไม่ใช่รายโปรเจกต์)
GEMINI_MODEL=gemini-3.5-flash
# โมเดลสำรองเมื่อตัวหลัก transient-fail
# ว่าง = ไม่สลับโมเดล (retry แล้วถอยไป local) — กันเผาโควตาตัวอื่นโดยไม่ตั้งใจ
GEMINI_FALLBACK_MODEL=
# โมเดลเฉพาะ gemini_web_search() (grounding ให้ local/Claude/Kimi)
# ว่าง = ใช้ GEMINI_MODEL · ⚠️ free tier ไม่เปิด google_search grounding (429 limit: 0)
GEMINI_SEARCH_MODEL=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite หลัก (แชท/เซสชัน/pins/shares/feedback 👍👎)
# ⛔ docker-compose `environment:` ทับค่านี้ — ตั้งใน .env ไม่มีผลบน prod
# (มีผลเฉพาะตอนรัน local ตรงๆ)
DB_PATH=./chat_history.db
# โฮสต์ ChromaDB (ความจำระยะยาว) — ว่าง = ให้โค้ดไล่เดาเอง
# บน Docker: ชื่อ service เช่น chromadb · บน NAS ที่รันแยก: IP ของ NAS
CHROMA_HOST=
# พอร์ต ChromaDB
CHROMA_PORT=8000
# ⚠️ dead config — ไม่มีผู้บริโภค (ChromaDB เป็นคอนเทนเนอร์แยก)
CHROMA_PATH=./data/chroma

# ── App ───────────────────────────────────────────────────────────────────────
# รหัสผ่านเข้า UI — ว่าง = เปิดสาธารณะ (auth middleware ยังกัน endpoint
# ที่ไม่อยู่ใน _OPEN_PATHS อยู่ แต่ไม่มีรหัสให้ผ่านด่าน)
UI_PASSWORD=
# origin ที่อนุญาต คั่นด้วย , — ว่าง = ใช้ค่าตั้งต้นใน CORS_ORIGINS_LIST
# ตัวอย่าง: http://192.168.51.49:8080,https://ai.pawinhome.com
CORS_ORIGINS=
# เปิด uvicorn auto-reload (สำหรับ dev เท่านั้น)
RELOAD=false

# ── Paths ─────────────────────────────────────────────────────────────────────
# path ของ Obsidian vault ที่มองเห็นจากในคอนเทนเนอร์ (Synology: /vault)
# ⛔ docker-compose `environment:` ทับค่านี้ — ตั้งใน .env ไม่มีผลบน prod
OBSIDIAN_VAULT_PATH=
# โฟลเดอร์ข้อมูลถาวรสำหรับ docker-compose volume mount
# (cache DB · reader.db · skills_db.json) — ตั้งเพื่อไม่ให้ข้อมูล
# หายเวลา restart container · Synology: /volume1/docker/hybrid-ai
NAS_DATA_PATH=./data
# ไฟล์เนื้อหาหนังสือ + ที่คั่นของโหมดอ่าน (แยกจาก chat_history.db)
READER_DB_PATH=./data/reader.db

# ── LM Studio ─────────────────────────────────────────────────────────────────
# ที่อยู่ LM Studio — **ว่าง = ปิด** (opt-in)
# ใส่ค่าเฉพาะเมื่อรัน LM Studio จริง เช่น http://192.168.51.235:1234/v1
# ⚠️ ห้ามใส่ IP เป็น default ในโค้ดไฟล์ใดๆ — เคยมี 4 ไฟล์ทำแบบนั้น
# แล้วระบบยิงหา PC เงียบๆ ทั้งที่ควรปิด (แก้ 2026-09-23)
LMSTUDIO_BASE_URL=
# โมเดลแชทของ LM Studio
LMSTUDIO_CHAT_MODEL=google/gemma-4-e4b
# โมเดลสำหรับงานวิเคราะห์ (สรุป/สะท้อน/dream)
LMSTUDIO_REASON_MODEL=qwen/qwen3.5-9b
# โมเดลอ่านรูปของ LM Studio
LMSTUDIO_VISION_MODEL=llama-3.2-11b-vision-instruct
# วินาที
LMSTUDIO_TIMEOUT=180
# token ของ LM Studio รุ่นใหม่ (หรือปิด "Require API key" ในตัวโปรแกรม)
# ว่าง/ไม่ตั้ง = ใช้ค่า placeholder (LM Studio ที่ปิด auth รับได้) — ไม่ทำให้แอปล้ม
LMSTUDIO_API_KEY=lmstudio
# โชว์ <think> ของโมเดลบน UI
SHOW_THINKING=false

# ── Claude (Anthropic) ────────────────────────────────────────────────────────
# คีย์ Anthropic — ว่าง = ปิด provider claude
ANTHROPIC_API_KEY=
# โมเดล Claude — claude-opus-4-8 = ฉลาดสุด/แพงสุด · claude-haiku-4-5 = ถูกสุด
CLAUDE_MODEL=claude-sonnet-4-6
# เพดานความยาวคำตอบ = คุม cost
CLAUDE_MAX_TOKENS=4096
# off | adaptive (คิดลึกขึ้นแต่ช้าลง)
CLAUDE_THINKING=off
# low|medium|high|xhigh|max (ใช้คู่ adaptive)
CLAUDE_EFFORT=high

# ── Kimi (Moonshot) ───────────────────────────────────────────────────────────
# คีย์ Moonshot — ว่าง = ปิด (โชว์ใน Model picker แบบ disabled)
MOONSHOT_API_KEY=
# endpoint — ใช้ .cn สำหรับ endpoint จีน
KIMI_BASE_URL=https://api.moonshot.ai/v1
# โมเดล Kimi
KIMI_MODEL=kimi-k2.6
# วินาที
KIMI_TIMEOUT=180

# ── Home Network ──────────────────────────────────────────────────────────────
# IP ของ NAS Synology (DSM API + ping)
NAS_IP=192.168.51.49
# พอร์ต DSM (http)
NAS_PORT=5000
# ผู้ใช้ DSM สำหรับอ่าน disk/docker
# ว่าง = tool nas_disk/nas_docker ตอบว่ายังไม่ตั้งค่า
NAS_USER=
# รหัสผ่าน DSM (⚠️ อย่า commit ค่าจริง)
NAS_PASS=
# IP เครื่อง PC (LM Studio/Ollama) สำหรับ ping_pc / ping_network
PC_IP=192.168.51.235
# MAC ของ PC สำหรับ Wake-on-LAN (xx:xx:xx:xx:xx:xx)
# ดูด้วย: ipconfig /all (Windows) หรือ ip link show (Linux) · ว่าง = WoL ใช้ไม่ได้
PC_MAC=
# IP router สำหรับ ping_network
# ว่าง = เดาจาก NAS_IP (x.y.z.1 ของ subnet เดียวกัน)
ROUTER_IP=

# ══ ⬆️ จบส่วนที่สร้างอัตโนมัติ · ข้างล่างนี้เขียนมือ (env ที่ยังไม่เข้า registry) ══

# ─────────────────────────────────────────────────────────────────────────────
# ข้างล่างนี้ยัง **เขียนมือ** — env ที่โค้ดอ่านจากไฟล์อื่น (ยังไม่เข้า registry)
# ย้ายเข้า registry เมื่อไร (เติมโมดูลใน core/env_registry.MODULES) ให้ลบออกจากตรงนี้แล้ว regenerate
# ─────────────────────────────────────────────────────────────────────────────

# Embedding function ของ ChromaDB — ปล่อยว่าง (default) = MiniLM เดิม (ใช้กับ
# ภาษาไทยไม่ได้เลย ทุกประโยคได้ vector เดียวกัน semantic recall เป็น noise ล้วน
# ดู wiki concepts/thai-embedding-chromadb.md). ตั้งเป็น paraphrase-multilingual
# เพื่อเปิดใช้จริง — ⚠️ ต้องรัน scripts/migrate_thai_embeddings.py ก่อน/หลังตั้งค่านี้
# (เปลี่ยน embedder = dimension เปลี่ยน ของเก่า query ไม่ได้ ต้อง re-embed ทุก collection)
# และต้อง `ollama pull paraphrase-multilingual` บน Ollama ที่ OLLAMA_BASE_URL ชี้ไปด้วย
EMBEDDING_MODEL=
# false = Ollama ล่มแล้วโยน error ไปเลย ไม่ลอง LM Studio
EMBED_FALLBACK_LMSTUDIO=true

# LINE Notify — แจ้งเตือนเมื่อ Dream Cycle ล้มเหลว
# ขอ token ได้ที่ https://notify-bot.line.me/my/
LINE_NOTIFY_TOKEN=

# ─── Backup dead-man's switch ────────────────────────────────────────────
# HEARTBEAT_URL — ยิงหลัง DB backup 03:30 สำเร็จ *จริง* เท่านั้น
# (backup ที่ได้ของเปล่า/พังกลางคัน = ไม่ยิง → ปลายทางเตือนเมื่อสัญญาณขาด)
# สร้าง check ที่ https://healthchecks.io แล้วตั้ง period 1 วัน + grace 2 ชม.
# ปล่อยว่าง = ปิดเงียบ (ไม่มีใครเฝ้าให้)
HEARTBEAT_URL=
HEARTBEAT_TIMEOUT=10
# ยิงซ้ำเฉพาะ "พังชั่วคราว" (ต่อไม่ติด / HTTP 5xx) — ไม่ยิงซ้ำเมื่อ body ผิดหรือ 4xx
# เพราะนั่นคือความผิดถาวร (uuid พิมพ์ผิด/check ถูกลบ) ยิงอีกกี่ครั้งก็ได้คำตอบเดิม
HEARTBEAT_ATTEMPTS=3
HEARTBEAT_RETRY_WAIT=10

# ── Web Search ───────────────────────────────────────────────────────────────
# ลำดับ provider: Brave → Google CSE → DDG (utils/websearch.py:search_web)
# Brave = ตัวหลัก เลือกเพราะ **ไม่ผูกกับ Google Cloud project** — ก่อนหน้านี้
# CSE ตาย 403 เพราะคีย์อยู่คนละ project กับที่เปิด API ไว้ แล้วไล่แก้วนกลับมาที่เดิม
BRAVE_SEARCH_API_KEY=
BRAVE_MIN_INTERVAL=1.1        # วินาที · free tier = 1 คำขอ/วิ (ค่า <=0 ถอยไปใช้ default)
GOOGLE_SEARCH_API_KEY=        # ชั้นสอง — คีย์ต้องอยู่ project ที่เปิด Custom Search JSON API
GOOGLE_SEARCH_CX=
WEB_SEARCH_MIN_SCORE=0.35     # พื้นคะแนนสัมบูรณ์ — ต่ำกว่านี้ไม่ฉีด/ไม่ cite (ปิดด้วย =off)
