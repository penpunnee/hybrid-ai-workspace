# ══ ⬇️ ส่วนนี้สร้างอัตโนมัติจาก core/env_registry.py — ห้ามแก้ด้วยมือ ══
# แก้คำอธิบาย/ค่าตั้งต้นที่ `core/config.py` แล้วรัน:
#     python scripts/gen_env_example.py --write
# มีเทสเทียบไฟล์นี้กับ registry ทุกครั้ง (tests/test_env_example_generated.py)


# ── Ollama ────────────────────────────────────────────────────────────────────
# ที่อยู่ Ollama (OpenAI-compatible) — ⚠️ พอร์ต 11434 ไม่ใช่ 1234
# บน Docker: http://host.docker.internal:11434/v1
# บน NAS ที่ Ollama รันบน PC แยกตัว: http://[PC-IP]:11434/v1
# เป็นตัวหลักของ embeddings (ทิศตรงข้ามกับงานแชทที่ LM Studio เป็นหลัก)
OLLAMA_BASE_URL=http://localhost:11434/v1
# โมเดลแชทของ Ollama (บทบาท fallback ตั้งแต่ 2026-06-15)
OLLAMA_MODEL=llama3
# วินาที
OLLAMA_TIMEOUT=120
# จำนวนครั้งที่ลองซ้ำ
OLLAMA_MAX_RETRIES=2
# วินาทีระหว่างการลองซ้ำ
OLLAMA_RETRY_DELAY=2
# ความสร้างสรรค์ 0-1
OLLAMA_TEMPERATURE=0.7
# nucleus sampling
OLLAMA_TOP_P=0.85
# ขนาด context window
OLLAMA_NUM_CTX=4096
# โทษการพูดซ้ำ
OLLAMA_REPEAT_PENALTY=1.1
# Embedding function ของ ChromaDB — ปล่อยว่าง (default) = MiniLM เดิม (ใช้กับ
# ภาษาไทยไม่ได้เลย ทุกประโยคได้ vector เดียวกัน semantic recall เป็น noise ล้วน
# ดู wiki concepts/thai-embedding-chromadb.md). ตั้งเป็น paraphrase-multilingual
# เพื่อเปิดใช้จริง — ⚠️ ต้องรัน scripts/migrate_thai_embeddings.py ก่อน/หลังตั้งค่านี้
# (เปลี่ยน embedder = dimension เปลี่ยน ของเก่า query ไม่ได้ ต้อง re-embed ทุก collection)
# และต้อง `ollama pull paraphrase-multilingual` บน Ollama ที่ OLLAMA_BASE_URL ชี้ไปด้วย
# ⛔ ห้ามใช้ nomic-embed-text เป็นตัวหลัก (พิสูจน์บน prod 2026-08-02: ไทยทุกประโยค cosine 1.0)
EMBEDDING_MODEL=

# ── Gemini ────────────────────────────────────────────────────────────────────
# คีย์ Gemini (ขอฟรีที่ https://aistudio.google.com/)
# ว่าง = ปิดเส้นคลาวด์ทั้งหมด
GEMINI_API_KEY=
# โมเดลสายเสียงสด — ต้องเป็นสาย *-live/native-audio เท่านั้น
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# โมเดลแชท Gemini (ค่าตั้งต้นอยู่ที่ utils/llm.py:GEMINI_MODEL_DEFAULT)
# ⚠️ ห้ามใช้รุ่นที่ Google ปิดแล้ว — ดู RETIRED_GEMINI_MODELS / GEMINI_MODEL_SUNSET
# prod ใช้ gemini-3.5-flash-lite (โควตาเป็นรายโมเดล ไม่ใช่รายโปรเจกต์)
GEMINI_MODEL=gemini-3.5-flash
# โมเดลสำรองเมื่อตัวหลัก transient-fail
# ว่าง = ไม่สลับโมเดล (retry แล้วถอยไป local) — กันเผาโควตาตัวอื่นโดยไม่ตั้งใจ
GEMINI_FALLBACK_MODEL=
# โมเดลเฉพาะ gemini_web_search() (grounding ให้ local/Claude/Kimi)
# ว่าง = ใช้ GEMINI_MODEL · ⚠️ free tier ไม่เปิด google_search grounding (429 limit: 0)
GEMINI_SEARCH_MODEL=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite หลัก (แชท/เซสชัน/pins/shares/feedback 👍👎)
# ⛔ docker-compose `environment:` ทับค่านี้ — ตั้งใน .env ไม่มีผลบน prod
# (มีผลเฉพาะตอนรัน local ตรงๆ)
DB_PATH=./chat_history.db
# โฮสต์ ChromaDB (ความจำระยะยาว) — ว่าง = ให้โค้ดไล่เดาเอง
# บน Docker: ชื่อ service เช่น chromadb · บน NAS ที่รันแยก: IP ของ NAS
CHROMA_HOST=
# พอร์ต ChromaDB
CHROMA_PORT=8000
# ⚠️ dead config — ไม่มีผู้บริโภค (ChromaDB เป็นคอนเทนเนอร์แยก)
CHROMA_PATH=./data/chroma

# ── App ───────────────────────────────────────────────────────────────────────
# รหัสผ่านเข้า UI — ว่าง = เปิดสาธารณะ (auth middleware ยังกัน endpoint
# ที่ไม่อยู่ใน _OPEN_PATHS อยู่ แต่ไม่มีรหัสให้ผ่านด่าน)
UI_PASSWORD=
# origin ที่อนุญาต คั่นด้วย , — ว่าง = ใช้ค่าตั้งต้นใน CORS_ORIGINS_LIST
# ตัวอย่าง: http://192.168.51.49:8080,https://ai.pawinhome.com
CORS_ORIGINS=
# เปิด uvicorn auto-reload (สำหรับ dev เท่านั้น)
RELOAD=false

# ── Observability ─────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR (ไม่สนตัวพิมพ์)
LOG_LEVEL=INFO
# plain | json (json = 1 บรรทัด/record สำหรับ log shipper)
LOG_FORMAT=plain
# ไฟล์ log (RotatingFileHandler 10 MB × 5) — prod ตั้งเป็น logs/server.log ในคอนเทนเนอร์ผ่าน compose
# ⛔ docker-compose `environment:` ทับค่านี้ — ตั้งใน .env ไม่มีผลบน prod
# (มีผลเฉพาะตอนรัน local ตรงๆ · รัน pytest บนเครื่องให้ตั้ง LOG_FILE=/tmp/... กันทับ log จริง)
LOG_FILE=server.log

# ── Paths ─────────────────────────────────────────────────────────────────────
# path ของ Obsidian vault ที่มองเห็นจากในคอนเทนเนอร์ (Synology: /vault)
# ⛔ docker-compose `environment:` ทับค่านี้ — ตั้งใน .env ไม่มีผลบน prod
OBSIDIAN_VAULT_PATH=
# โฟลเดอร์ข้อมูลถาวรสำหรับ docker-compose volume mount
# (cache DB · reader.db · skills_db.json) — ตั้งเพื่อไม่ให้ข้อมูล
# หายเวลา restart container · Synology: /volume1/docker/hybrid-ai
NAS_DATA_PATH=./data
# ไฟล์เนื้อหาหนังสือ + ที่คั่นของโหมดอ่าน (แยกจาก chat_history.db)
READER_DB_PATH=./data/reader.db

# ── LM Studio ─────────────────────────────────────────────────────────────────
# ที่อยู่ LM Studio — **ว่าง = ปิด** (opt-in)
# ใส่ค่าเฉพาะเมื่อรัน LM Studio จริง เช่น http://192.168.51.235:1234/v1
# ⚠️ ห้ามใส่ IP เป็น default ในโค้ดไฟล์ใดๆ — เคยมี 4 ไฟล์ทำแบบนั้น
# แล้วระบบยิงหา PC เงียบๆ ทั้งที่ควรปิด (แก้ 2026-09-23)
LMSTUDIO_BASE_URL=
# โมเดลแชทของ LM Studio
LMSTUDIO_CHAT_MODEL=google/gemma-4-e4b
# โมเดลสำหรับงานวิเคราะห์ (สรุป/สะท้อน/dream)
LMSTUDIO_REASON_MODEL=qwen/qwen3.5-9b
# โมเดลอ่านรูปของ LM Studio
LMSTUDIO_VISION_MODEL=llama-3.2-11b-vision-instruct
# วินาที
LMSTUDIO_TIMEOUT=180
# token ของ LM Studio รุ่นใหม่ (หรือปิด "Require API key" ในตัวโปรแกรม)
# ว่าง/ไม่ตั้ง = ใช้ค่า placeholder (LM Studio ที่ปิด auth รับได้) — ไม่ทำให้แอปล้ม
LMSTUDIO_API_KEY=lmstudio
# โชว์ <think> ของโมเดลบน UI
SHOW_THINKING=false

# ── Claude (Anthropic) ────────────────────────────────────────────────────────
# คีย์ Anthropic — ว่าง = ปิด provider claude
ANTHROPIC_API_KEY=
# โมเดล Claude — claude-opus-4-8 = ฉลาดสุด/แพงสุด · claude-haiku-4-5 = ถูกสุด
CLAUDE_MODEL=claude-sonnet-4-6
# เพดานความยาวคำตอบ = คุม cost
CLAUDE_MAX_TOKENS=4096
# off | adaptive (คิดลึกขึ้นแต่ช้าลง)
CLAUDE_THINKING=off
# low|medium|high|xhigh|max (ใช้คู่ adaptive)
CLAUDE_EFFORT=high

# ── Kimi (Moonshot) ───────────────────────────────────────────────────────────
# คีย์ Moonshot — ว่าง = ปิด (โชว์ใน Model picker แบบ disabled)
MOONSHOT_API_KEY=
# endpoint — ใช้ .cn สำหรับ endpoint จีน
KIMI_BASE_URL=https://api.moonshot.ai/v1
# โมเดล Kimi
KIMI_MODEL=kimi-k2.6
# วินาที
KIMI_TIMEOUT=180

# ── Home Network ──────────────────────────────────────────────────────────────
# IP ของ NAS Synology (DSM API + ping)
NAS_IP=192.168.51.49
# พอร์ต DSM (http)
NAS_PORT=5000
# ผู้ใช้ DSM สำหรับอ่าน disk/docker
# ว่าง = tool nas_disk/nas_docker ตอบว่ายังไม่ตั้งค่า
NAS_USER=
# รหัสผ่าน DSM (⚠️ อย่า commit ค่าจริง)
NAS_PASS=
# IP เครื่อง PC (LM Studio/Ollama) สำหรับ ping_pc / ping_network
PC_IP=192.168.51.235
# MAC ของ PC สำหรับ Wake-on-LAN (xx:xx:xx:xx:xx:xx)
# ดูด้วย: ipconfig /all (Windows) หรือ ip link show (Linux) · ว่าง = WoL ใช้ไม่ได้
PC_MAC=
# IP router สำหรับ ping_network
# ว่าง = เดาจาก NAS_IP (x.y.z.1 ของ subnet เดียวกัน)
ROUTER_IP=

# ── Voice ─────────────────────────────────────────────────────────────────────
# log ระดับเสียงที่ Gemini ส่งมา ([VoiceLevel] ทุก VOICE_LEVEL_WINDOW_SEC วินาทีของเสียง)
# off/0/false = ปิด · อย่างอื่น = เปิด — เครื่องมือชี้ขาดคดี "เสียงเบา" (ดู AudioLevelMeter)
VOICE_LEVEL_LOG=on
# วินาทีของเสียงต่อ 1 บรรทัด [VoiceLevel]
VOICE_LEVEL_WINDOW_SEC=10.0
# เปิดสายเสียงซ้ำภายในกี่วินาทีถึงติดธง ⚠️ ว่าเป็น reconnect วน (ไม่ใช่เปิดใหม่ตั้งใจ)
# 30 = retry ของ client หมดโควตาใน ~7s (1+2+4) เผื่อ timer ถูก throttle ตอน background
VOICE_RECONNECT_SUSPECT_SEC=30.0
# watchdog โหมดอ่านนิยาย: Gemini เงียบเกินกี่วินาทีกลางท่อน = ตายเงียบ → ต่อ session ใหม่
# 45 = chunk ปกติห่างกัน <5s ⇒ เกินนี้คือตาย ไม่ใช่ช้า · ต้องมากกว่า VOICE_LOOP_EXIT_GRACE_SEC
READER_STALL_TIMEOUT=45.0
# หลังลูปหนึ่งของสายเสียงจบ รออีกฝั่งกี่วินาทีก่อน cancel (run_until_both_done)
# ต้อง >1.0 (recv_loop ตื่นทุก 1s) และ < READER_STALL_TIMEOUT
VOICE_LOOP_EXIT_GRACE_SEC=1.5

# ── FS Tools (agent) ──────────────────────────────────────────────────────────
# โฟลเดอร์ที่ agent อ่าน/เขียนได้ คั่นด้วย : (whitelist — นอกนี้ปฏิเสธทั้งหมด)
# ว่าง = ~/Desktop/ui/sandbox · ในคอนเทนเนอร์ต้องตั้งให้ตรง volume mount ของ sandbox
# (ดูคู่กันใน docker-compose.yml — ห้ามเขียน path ในคอนเทนเนอร์ตรงนี้: CI ตรวจว่า repo root
# ของเครื่องที่ generate ไม่หลุดเข้า .env.example และในอิมเมจ repo root คือ path นั้นพอดี)
FS_TOOLS_ROOTS=
# ไบต์สูงสุดต่อการอ่านไฟล์ (1 MB)
FS_TOOLS_MAX_READ=1048576
# ไบต์สูงสุดต่อการเขียนไฟล์ (256 KB)
FS_TOOLS_MAX_WRITE=262144
# จำนวนรายการสูงสุดต่อการ list โฟลเดอร์
FS_TOOLS_MAX_LIST=500
# ความยาว regex สูงสุดของ search_files (ตัวอักษร)
FS_TOOLS_MAX_PATTERN=200
# วินาทีสูงสุดของ search_files ทั้งก้อน (กัน regex/โฟลเดอร์ใหญ่กินเวลา)
FS_TOOLS_SEARCH_DEADLINE=5.0

# ── Embeddings ────────────────────────────────────────────────────────────────
# วินาที timeout ต่อคำขอ embedding (ทั้ง Ollama ตัวหลักและ LM Studio fallback)
LMSTUDIO_EMBED_TIMEOUT=30
# false = Ollama ล่มแล้วโยน error ไปเลย ไม่ลอง LM Studio (โมเดลชื่อเดียวกันเท่านั้น)
EMBED_FALLBACK_LMSTUDIO=true
# SQLite เก็บ embedding ที่เคยคำนวณ (Phase E) — ว่าง = <NAS_DATA_PATH>/embed_cache.db
EMBED_CACHE_DB=
# false = คำนวณ embedding ใหม่ทุกครั้ง
EMBED_CACHE_ENABLED=true

# ── Code Sandbox (agent) ──────────────────────────────────────────────────────
# อิมเมจที่ใช้รัน run_python (ต้องมีบนเครื่องที่รัน docker)
CODE_SANDBOX_IMAGE=python:3.11-slim
# วินาที default ต่อการรันโค้ด
CODE_SANDBOX_TIMEOUT=10
# เพดานวินาทีที่ caller ขอได้
CODE_SANDBOX_MAX_TIMEOUT=60
# docker --memory
CODE_SANDBOX_MEM=256m
# docker --cpus
CODE_SANDBOX_CPU=0.5
# ⚠️ true = รันบน host ตรงๆ โดยไม่มี Docker (ไม่มี isolation) — ใช้เฉพาะ dev
CODE_SANDBOX_ALLOW_LOCAL=false

# ── Web Search ────────────────────────────────────────────────────────────────
# พื้นคะแนนสัมบูรณ์ของผลค้นเว็บ (rerank × credibility) — ต่ำกว่านี้ไม่ฉีด/ไม่ cite
# วัดบน prod: ผลถูกต้อง 0.60-0.82 · ขยะ 0.10-0.24 ⇒ 0.35 อยู่กลางที่ราบ · ปิดด้วย =off
WEB_SEARCH_MIN_SCORE=0.35
# ตัวหลัก (ไม่ผูกกับ Google Cloud project) · ว่าง = ปิด ไม่ยิงเน็ตเลย ไม่บ่น
BRAVE_SEARCH_API_KEY=
# วินาทีหน่วงระหว่างคำขอ Brave · free tier = 1 คำขอ/วิ (sub-query ยิงติดกันในลูปเดียว)
# ค่า <=0 หรือพิมพ์ผิด ถอยไป 1.1 พร้อม warning — ไม่หน่วง = ตัวที่ 2 ได้ 429 ทุกครั้ง
BRAVE_MIN_INTERVAL=1.1
# ชั้นสอง — คีย์ต้องอยู่ project ที่เปิด Custom Search JSON API · ว่าง = ข้าม
GOOGLE_SEARCH_API_KEY=
# Programmable Search Engine ID คู่กับคีย์ข้างบน
GOOGLE_SEARCH_CX=

# ── Response Cache (Phase E) ──────────────────────────────────────────────────
# SQLite เก็บคำตอบที่เคย 👍 สำหรับ semantic cache — ว่าง = <NAS_DATA_PATH>/response_cache.db
RESPONSE_CACHE_DB=
# false = ไม่ short-circuit ด้วยคำตอบเดิม (คำถาม real-time bypass อยู่แล้ว)
RESPONSE_CACHE_ENABLED=true
# cosine ขั้นต่ำที่ถือว่า prompt ใกล้พอจะคืนคำตอบเดิม
RESPONSE_CACHE_THRESHOLD=0.92
# อายุรายการ (วัน)
RESPONSE_CACHE_TTL_DAYS=30
# จำนวนรายการสูงสุด (เก่าสุดถูกไล่ออก)
RESPONSE_CACHE_MAX=1000

# ── Memory ────────────────────────────────────────────────────────────────────
# cosine ขั้นต่ำของ episodic recall — จาก ground truth 50 คู่ที่คนมาร์ค (ช่วงที่รองรับ 0.525-0.65)
# ⚠️ อย่าใช้เลขนี้กับ user_facts (คนละลักษณะข้อความ)
RECALL_MIN_SCORE=0.55
# วินาที timeout ของ LLM ที่สกัด "ข้อเท็จจริงที่ถูก" จากคำแก้ของผู้ใช้ (รันในเธรดเบื้องหลัง ผู้ใช้ไม่รอ)
# โมเดล reasoning ใช้จริง ~40-60 วิ
CORRECTION_EXTRACT_TIMEOUT=60.0
# พื้นคะแนน lexical (OR-gate คู่ semantic) ของ recall — ที่ราบ 0.45-0.70 · noise สูงสุดที่วัดได้ 0.409
# 0.50 = กลางที่ราบ เหนือ noise พอมีระยะเผื่อ
LEXICAL_MIN_SCORE=0.5

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# false = ปิดทั้ง rate limit และ brute-force lockout (LAN/loopback bypass อยู่แล้ว)
RATE_LIMIT_ENABLED=true
# คำขอ/นาที/IP (เกิน = 429)
RATE_LIMIT_RPM=120
# 401 กี่ครั้งใน AUTH_FAIL_WINDOW ก่อน lock IP (นับเฉพาะที่ส่ง x-auth-token ผิด หรือ /api/auth/login)
AUTH_FAIL_MAX=8
# วินาทีของหน้าต่างนับ 401
AUTH_FAIL_WINDOW=300.0
# จำนวน IP สูงสุดที่ track พร้อมกัน (กัน memory DoS จาก IP สุ่ม)
RATE_LIMIT_MAX_KEYS=50000

# ── Reflection (Phase C) ──────────────────────────────────────────────────────
# โมเดล critic (LM Studio) — ว่าง = LMSTUDIO_REASON_MODEL
REFLECTION_MODEL=
# วินาที timeout ของ critic (opt-in ต่อ request ด้วย reflect:true)
REFLECTION_TIMEOUT=30
# คะแนน 0-1 ที่ต่ำกว่านี้ critic จะเสนอ revised answer
REFLECTION_THRESHOLD=0.7

# ── Query Rewrite (Phase B) ───────────────────────────────────────────────────
# โมเดล rewrite คำค้น (LM Studio) — ว่าง = LMSTUDIO_CHAT_MODEL
QUERY_REWRITE_MODEL=
# วินาที timeout (เกิน = ใช้ _fallback/clean_query)
QUERY_REWRITE_TIMEOUT=8
# false = ไม่เรียก LLM rewrite เลย (ใช้ clean_query กฎล้วน)
# ⚠️ กับ Qwen3.5 เส้น LLM เป็น no-op อยู่แล้ว (finish_reason=length · thinking ปิดไม่ได้) — ดู CLAUDE.md
QUERY_REWRITE_ENABLED=true

# ── Dream Cycle ───────────────────────────────────────────────────────────────
# ธีมต้องเจอกี่ครั้งใน 24 ชม. ถึงเลื่อนขั้นเข้า long_term_memory (Deep Sleep)
# ≥2 = ต้องเป็น "รูปแบบที่เกิดซ้ำ" (เดิม 1 = ไม่กรอง → prod ได้ skill ขยะ 60 อัน)
DREAM_PROMOTE_MIN_HITS=2
# true = ให้ Dream เขียนธีมลง skills_db.json ด้วย (ปิดตั้งแต่ 2026-08-02: 3 เดือนได้ 60 skill ใช้ได้ 1)
# long_term_memory / decay / prune ทำงานปกติไม่ว่าค่านี้เป็นอะไร
DREAM_PROMOTE_SKILLS=false
# เพดานจำนวน episodic memory ที่ไม่ใช่ verified/user_taught ต่อผู้ช่วย — เกินแล้ว prune ตัว retention ต่ำสุด
MEMORY_EPISODIC_CAP=500
# วินาทีสูงสุดของ POST /api/dream/run (เกิน = 504 · job กลางคืนไม่ผ่านเพดานนี้)
DREAM_TIMEOUT=600
# LINE Notify token — แจ้งเตือนเมื่อ Dream Cycle ล้มเหลว · ขอได้ที่ https://notify-bot.line.me/my/
# ว่าง = ไม่แจ้ง
LINE_NOTIFY_TOKEN=

# ── Backup dead-man's switch ──────────────────────────────────────────────────
# ยิงหลัง DB backup 03:30 สำเร็จ *จริง* เท่านั้น (ของเปล่า/พังกลางคัน = ไม่ยิง → ปลายทางเตือนเมื่อสัญญาณขาด)
# สร้าง check ที่ https://healthchecks.io แล้วตั้ง period 1 วัน + grace 2 ชม. · ว่าง = ปิดเงียบ (ไม่มีใครเฝ้า)
HEARTBEAT_URL=
# วินาที timeout ต่อการยิง
HEARTBEAT_TIMEOUT=10.0
# ยิงซ้ำเฉพาะ "พังชั่วคราว" (ต่อไม่ติด / HTTP 5xx) — ไม่ยิงซ้ำเมื่อ body ผิดหรือ 4xx
# เพราะนั่นคือความผิดถาวร (uuid พิมพ์ผิด/check ถูกลบ) ยิงอีกกี่ครั้งก็ได้คำตอบเดิม
HEARTBEAT_ATTEMPTS=3
# วินาทีระหว่างการยิงซ้ำ
HEARTBEAT_RETRY_WAIT=10.0

# ── Skills ────────────────────────────────────────────────────────────────────
# พื้นคะแนน cosine ของ search_skills() (ChromaDB skills_collection) — ต่ำกว่านี้ไม่ฉีด
# 0.38 จาก sweep ground truth 110 คู่ (P 0.583/R 0.636) · ห้ามยืมเลข 0.35 ของ WEB/FALLBACK (คนละ scorer)
# off = ปิดพื้น (พฤติกรรมก่อน 2026-08-04)
SKILLS_SEARCH_MIN_SCORE=0.38
# วินาทีสูงสุดที่รอ file lock ของ skills_db.json ก่อนโยน SkillsDbLocked (fail-fast — เส้นเขียนอยู่ใน threadpool 40 slot)
# off = รอไม่จำกัด (พฤติกรรมก่อน 2026-08-04) · scripts/clean_skills_db.py ใช้เพดานยาวกว่านี้เอง
SKILLS_DB_LOCK_TIMEOUT=5
# ช่องห่างคะแนนขั้นต่ำระหว่างอันดับ 1 กับ 2 ของ rule-based fallback ถึงจะฉีด (กันเลือกมั่วตอนคะแนนเสมอ)
# ค่าพิมพ์ผิด/ติดลบ = ปิดฟีเจอร์ (ห้าม crash ตอน import — นี่คือเส้นแชทหลัก)
SKILLS_FALLBACK_MARGIN=0.05
# พื้นคะแนนสัมบูรณ์ของ rule-based fallback (เมื่อ ChromaDB ล่ม) — 0.35 = p90 ของอันดับ 1 ฝั่งไทย (0.347)
# 0.40 ตัดไทยเหลือ 5.9% · คนละ scorer กับ SKILLS_SEARCH_MIN_SCORE/WEB_SEARCH_MIN_SCORE
SKILLS_FALLBACK_MIN_SCORE=0.35
# บันทึก shadow log ของการเลือก skill (semantic vs rule) ลง SQLite ทุกเทิร์น — ข้อมูลสำหรับจูนเกณฑ์
# เปิดเป็น default: ปิดไว้แล้วลืมเปิด = "ตั้ง cron ไว้ไม่ได้แปลว่ามันรัน"
SKILLS_SHADOW_LOG=true

# ── Obsidian Vault ────────────────────────────────────────────────────────────
# คะแนนความคล้ายขั้นต่ำที่โน้ตถือว่า "เกี่ยวข้อง" พอจะฉีด/อ้างอิง
# วัด prod 2026-08-02: คำถามไม่เกี่ยว ≤0.40 · ที่ตรงจริง 0.72-0.74
VAULT_MIN_SCORE=0.5

# ── DB Backup (03:30) ─────────────────────────────────────────────────────────
# โฟลเดอร์เก็บ tar.gz ของ chat_history/reader/cache DBs — relative จาก cwd โดยตั้งใจ:
# ในคอนเทนเนอร์ cwd คือรากแอป ⇒ ตรงกับ volume mount db_backups ใน docker-compose.yml
DB_BACKUP_DEST=./db_backups
# เก็บกี่วัน (ใบเก่ากว่านี้ถูกลบหลัง backup สำเร็จ)
DB_BACKUP_RETAIN=7

# ── Reader (นิยาย) ────────────────────────────────────────────────────────────
# ไบต์สูงสุดของไฟล์หนังสือที่อ่านจากดิสก์ (คนละเพดานกับ HTTP body) — เล่มใหญ่สุดจริง 56.8 MB → เผื่อ ~3.5 เท่า
READER_MAX_DISK_BYTES=209715200

# ── Documents (Phase B) ───────────────────────────────────────────────────────
# similarity ขั้นต่ำที่จะดึง chunk เอกสารที่อัปโหลดเข้า context ของแชท
DOC_RETRIEVAL_MIN_SCORE=0.5

# ── Image Generation ──────────────────────────────────────────────────────────
# โมเดล Gemini สร้างรูป — ⛔ free tier ไม่เปิดให้ทุกตัว (429 limit:0) ใช้ได้เมื่อเปิด billing (~$0.04/รูป)
IMAGE_GEN_MODEL=gemini-2.5-flash-image

# ── File Export (agent) ───────────────────────────────────────────────────────
# ไบต์สูงสุดต่อไฟล์ที่ tool export_file เขียนให้ดาวน์โหลด (1 MB)
EXPORT_MAX_BYTES=1048576

# ══ ⬆️ จบส่วนที่สร้างอัตโนมัติ · ข้างล่างนี้เขียนมือ (env ที่ยังไม่เข้า registry) ══

# ─────────────────────────────────────────────────────────────────────────────
# ข้างล่างนี้ยัง **เขียนมือ** — env ที่โค้ดอ่านจากไฟล์อื่น (ยังไม่เข้า registry)
# ย้ายเข้า registry เมื่อไร (เติมโมดูลใน core/env_registry.MODULES) ให้ลบออกจากตรงนี้แล้ว regenerate
# ─────────────────────────────────────────────────────────────────────────────

